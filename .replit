modules = ["python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[workflows]

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
DJANGO_SUPERUSER_EMAIL = "jamaral@anthemsoftware.com"
DJANGO_SUPERUSER_USERNAME = "jamaral@anthemsoftware.com"
