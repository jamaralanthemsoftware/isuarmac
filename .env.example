# Django: use development locally, preview for a hosted client-review site,
# and production only when the launch infrastructure is ready.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# Hardened staff administration.
# Keep the standard template admin URL; generate a unique emergency path per client.
ADMIN_URL=admin/jamarallogin/
ADMIN_LOCAL_LOGIN_URL=emergency-admin-login/
ENABLE_GOOGLE_ADMIN_SSO=false
ADMIN_GOOGLE_ALLOWED_EMAILS=
DJANGO_SUPERUSER_USERNAME=jamaral@anthemsoftware.com
DJANGO_SUPERUSER_EMAIL=jamaral@anthemsoftware.com
DJANGO_SUPERUSER_PASSWORD=

# Create a NEW Google OAuth web application for every client.
# Authorized redirect URI:
# https://CLIENT-DOMAIN/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GA4 and Search Console service authorization. This is separate from admin SSO.
# Enable the Google Analytics Admin API, Search Console API, and Site Verification API.
# Authorized redirect URI:
# https://CLIENT-DOMAIN/integrations/google/callback/
GOOGLE_SERVICES_OAUTH_CLIENT_ID=
GOOGLE_SERVICES_OAUTH_CLIENT_SECRET=
# Generate a Fernet key; do not reuse Django SECRET_KEY as this value.
GOOGLE_SERVICES_ENCRYPTION_KEY=
GOOGLE_SERVICES_CALLBACK_URI=https://CLIENT-DOMAIN/integrations/google/callback/

# Database: omit locally or in a single-instance Replit preview to use SQLite.
# Production must provide a PostgreSQL URL.
DATABASE_URL=
REQUIRE_POSTGRES=false
SQLITE_PATH=

# Email: create a NEW provider connection for every client.
# For Postmark, use that client's server token as EMAIL_HOST_PASSWORD.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Website <website@example.com>
SERVER_EMAIL=errors@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Google and other public site identifiers.
# Leave blank in the template and issue new values for each client.
GOOGLE_ANALYTICS_MEASUREMENT_ID=
ANALYTICS_CONSENT_REQUIRED=false
# Comma-separated HTTPS origins allowed by the selective third-party script helper.
THIRD_PARTY_SCRIPT_ORIGINS=
GOOGLE_TAG_MANAGER_CONTAINER_ID=
GOOGLE_SITE_VERIFICATION=
GOOGLE_MAPS_API_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional DigitalOcean Spaces media storage.
# Create a NEW bucket and access key for every client.
USE_SPACES=false
SERVE_LOCAL_MEDIA=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=nyc3
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_S3_CUSTOM_DOMAIN=

# Optional first-admin provisioning.
# Use a unique account and password for every client.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
